<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV. Both target devices are leanback-only: no touchscreen, and
         the launcher only shows LEANBACK_LAUNCHER activities. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- USB host mode for Xbox pads / the Wireless Adapter. Not required: the app
         streams fine without a pad plugged in. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="Sunburst"
        android:supportsRtl="true">

        <!-- The streaming client: the leanback launcher entry. -->
        <activity
            android:name=".StreamActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Sunburst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pairing screen, opened by the stream activity when unpaired. -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:label="Sunburst pairing" />

        <!-- Settings screen, opened from the stream activity with the Menu key. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Sunburst settings" />

        <!-- Invisible: only carries the USB_DEVICE_ATTACHED filter so Android
             offers "use by default for this USB device". It claims nothing and
             finishes immediately; UsbBridge does the actual claiming. -->
        <activity
            android:name=".UsbAttachTrampoline"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Phase 0 decoder probe, kept for adb-driven enumeration; no longer the
             launcher. Start with: adb shell am start -n com.trexx.sunburst/.probe.DecoderProbeActivity -->
        <activity
            android:name=".probe.DecoderProbeActivity"
            android:exported="true"
            android:label="Sunburst Probe" />
    </application>

</manifest>
