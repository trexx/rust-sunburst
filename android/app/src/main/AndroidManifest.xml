<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV. Both target devices are leanback-only: no touchscreen, and
         the launcher only shows LEANBACK_LAUNCHER activities. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="Sunburst"
        android:supportsRtl="true">

        <!-- The streaming client: the leanback launcher entry. -->
        <activity
            android:name=".StreamActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Sunburst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pairing screen, opened by the stream activity when unpaired. -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:label="Sunburst pairing" />

        <!-- Phase 0 decoder probe, kept for adb-driven enumeration; no longer the
             launcher. Start with: adb shell am start -n com.trexx.sunburst/.probe.DecoderProbeActivity -->
        <activity
            android:name=".probe.DecoderProbeActivity"
            android:exported="true"
            android:label="Sunburst Probe" />
    </application>

</manifest>
